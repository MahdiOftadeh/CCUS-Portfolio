# Normalize line endings and encoding for text files
# Prevents UTF-8 BOM regressions that break TOML parsers (tomli/tomllib)
*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.html linguist-detectable=false
